# Copy this file to .env and adjust it. Never commit .env: it holds credentials.
# Real environment variables take precedence over values in this file.
# Relative paths are resolved against the folder that contains the .env file.

# ---------------------------------------------------------------------------
# Model weights (download them with scripts/download_weights.py)
# ---------------------------------------------------------------------------
WEIGHTS_DIR=models/weights
# Optional per-model overrides:
# FINDCARD_WEIGHTS=models/weights/findCard.pt
# TEXT_WEIGHTS=models/weights/text.pt
# MRZ_WEIGHTS=models/weights/MRZ1.pt

# ---------------------------------------------------------------------------
# Inference
# ---------------------------------------------------------------------------
# YOLO device: empty = automatic (GPU when available), or cpu, 0, cuda:0
YOLO_DEVICE=
# PaddleOCR recognition model and device (cpu, gpu, gpu:0)
OCR_MODEL_NAME=arabic_PP-OCRv5_mobile_rec
OCR_DEVICE=cpu
# Full path to the tesseract binary when it is not on PATH (needed for the MRZ), e.g.
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
TESSERACT_CMD=

# Thresholds (the defaults reproduce the original pipeline)
DETECT_CONF=0.25
SECOND_PASS_CONF=0.50
ORIENTATION_MARGIN=0.10

# ---------------------------------------------------------------------------
# Output and logging
# ---------------------------------------------------------------------------
OUTPUT_DIR=output
LOG_LEVEL=INFO
# LOG_FILE=logs/idcard.log
# Mask national IDs and names in logs and database error messages.
MASK_PII_IN_LOGS=true

# ---------------------------------------------------------------------------
# Database (used by `idcard-extract run --db` and `idcard-extract db ...`)
# ---------------------------------------------------------------------------
# sqlite | postgresql | mysql | mariadb | mssql
DB_DIALECT=sqlite
# SQLite: path of the database file. Server databases: the database name.
DB_NAME=data/idcards.db
DB_HOST=
DB_PORT=
DB_USER=
# Prefer DB_PASSWORD_FILE (a file readable only by the service account).
DB_PASSWORD=
# DB_PASSWORD_FILE=/run/secrets/db_password

# TLS: disable | require (encrypt only) | verify-ca | verify-full (recommended)
DB_SSL_MODE=disable
# DB_SSL_CA=certs/ca.pem
# DB_SSL_CERT=certs/client-cert.pem
# DB_SSL_KEY=certs/client-key.pem

# Seconds to wait for the server when connecting.
DB_CONNECT_TIMEOUT=10
# SQL Server only:
# DB_ODBC_DRIVER=ODBC Driver 18 for SQL Server
# Optional: override the driver, e.g. postgresql+psycopg2 or mysql+mysqldb
# DB_DRIVER=
# Alternative to all DB_* connection variables above (takes precedence):
# DATABASE_URL=postgresql+psycopg://user:password@db.example.com:5432/registry
DB_ECHO=false

# Which table/columns receive the data: see config/db_mapping.example.yaml
DB_MAPPING_FILE=config/db_mapping.yaml
# Records that could not be written are kept here for `idcard-extract db retry`.
# This file contains personal data. Set to "none" to disable it.
DB_FAILED_RECORDS_FILE=output/db_failed_records.jsonl
